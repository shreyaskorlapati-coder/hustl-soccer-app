# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/soccer_app

# JWT signing secret — MUST be changed before going to production.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=sakah-dev-secret-change-in-production

# ---------------------------------------------------------------------------
# Google OAuth — https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------

# Mobile clients (React Native / Expo Go)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Web client — also required for the authorization-code callback flow
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The redirect_uri registered in Google Cloud Console for the web client.
# Must exactly match the URI used by your frontend during the OAuth flow.
# Example: http://localhost:8081 (Expo Dev), https://yourapp.com/auth/callback (prod)
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Password reset — SMTP email delivery
#
# If these are left empty the OTP code is printed to the server log instead
# of being emailed (useful during local development).
# ---------------------------------------------------------------------------

# SMTP server hostname (e.g. smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=
# SMTP port — 587 for STARTTLS (recommended), 465 for SSL
SMTP_PORT=587
# Login credentials for the SMTP account
SMTP_USER=
SMTP_PASS=
# "From" address shown in the email (defaults to SMTP_USER when empty)
SMTP_FROM=

# ---------------------------------------------------------------------------
# Optional runtime flags
# ---------------------------------------------------------------------------

# Set to "true" on Vercel / serverless — skips DB table creation at startup
# (run Alembic migrations separately instead).
SKIP_DB_INIT=false
